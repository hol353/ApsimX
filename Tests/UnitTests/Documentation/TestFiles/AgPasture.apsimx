                        },
                        {
                          "$type": "Models.Report, Models",
                          "VariableNames": [
                            "[Clock].Today as Date",
                            "",
                            "// plant outputs",
                            "[MicroClimate].RadiationInterceptionOnGreen as RadiationInterceptedOnGreen",
                            "Sum of ([MicroClimate].RadiationInterceptionOnGreen) from 1-jul to [Clock].Today as RadiationInterceptedOnGreenCum",
                            "",
                            "[MicroClimate].CanopyCover as CanopyCover ",
                            "[AgPWhiteClover].TotalWt/([AgPRyegrass].TotalWt + [AgPWhiteClover].TotalWt + 0.000000001) as CloverContent_tot",
                            "[AgPWhiteClover].AboveGroundWt/([AgPRyegrass].AboveGroundWt + [AgPWhiteClover].AboveGroundWt + 0.000000001) as CloverContent_abvg",
                            "[AgPWhiteClover].HarvestedWt/([AgPRyegrass].HarvestedWt + [AgPWhiteClover].HarvestedWt + 0.000000001) as CloverContent_harv",
                            "([AgPRyegrass].RootWt*[AgPRyegrass].RootWtFraction + [AgPWhiteClover].RootWt*[AgPWhiteClover].RootWtFraction) as RootWtByLayer",
                            "([AgPRyegrass].WaterUptake + [AgPWhiteClover].WaterUptake) as WaterUptakeByLayer",
                            "([AgPRyegrass].NitrogenUptake + [AgPWhiteClover].NitrogenUptake) as NitrogenUptakeByLayer",
                            "",
                            "// defoliations",
                            "[DefoliationManager].Script.PreHarvestDM*10.0 as PreGrazeDM",
                            "[DefoliationManager].Script.PostHarvestDM*10.0 as PostGrazeDM",
                            "[DefoliationManager].Script.DefoliatedN*10.0 as DefoliatedN",
                            "[DefoliationManager].Script.DefoliatedWt*10.0 as DefoliatedDM",
                            "[DefoliationManager].Script.RemovedWt*10.0 as RemovedWt",
                            "[DefoliationManager].Script.RemovedN*10.0 as RemovedN",
                            "Sum of ([DefoliationManager].Script.RemovedWt*10.0) from 1-jul to [Clock].Today as RemovedWtCum",
                            "Sum of ([DefoliationManager].Script.RemovedN*10.0) from 1-jul to [Clock].Today as RemovedNCum",
                            "[DefoliationManager].Script.ReturnedWt*10.0 as DungDepositedWt",
                            "Sum of ([DefoliationManager].Script.ReturnedWt*10.0) from 1-jul to [Clock].Today as DungDepositedWtCum",
                            "([AGPRyegrass].HarvestedWt + [AGPWhiteClover].HarvestedWt) as AgPasture.HarvestedWt",
                            "[AGPRyegrass].HarvestedWt",
                            "[AGPWhiteClover].HarvestedWt",
                            "",
                            "// surface OM",
                            "([AgPRyegrass].LitterDepositionWt+[AgPRyegrass].RootDetachedWt+[AgPWhiteClover].LitterDepositionWt+[AgPWhiteClover].RootDetachedWt)*0.4/([AgPRyegrass].LitterDepositionN+[AgPRyegrass].RootDetachedN+[AgPWhiteClover].LitterDepositionN+[AgPWhiteClover].RootDetachedN+0.00000001) as Litter.CN",
                            "[DefoliationManager].Script.ReturnedWt*0.4/([DefoliationManager].Script.NReturnedInDung + 0.00000001) as Dung.CN",
                            "[SurfaceOrganicMatter].Wt",
                            "[SurfaceOrganicMatter].C/([SurfaceOrganicMatter].N + 0.00000001) as SurfaceOrganicMatter.CN",
                            "",
                            "// soil water",
                            "(sum([Soil].Water.MM)-sum([Soil].Physical.LL15mm))/(sum([Soil].Physical.DULmm)-sum([Soil].Physical.LL15mm)) as ProfileWaterStatus",
                            "[Soil].Water.Volumetric",
                            "",
                            "// soil nitrogen",
                            "[Soil].Nutrient.FOM.C/0.4 as Soil.FOM.Wt",
                            "[Soil].Nutrient.FOM.C/([Soil].Nutrient.FOM.N + 0.00000001) as Soil.FOM.CN",
                            "([Soil].Nutrient.Microbial.C + [Soil].Nutrient.Humic.C + [Soil].Nutrient.Inert.C)*100.0/([Soil].Physical.BD * [Soil].Physical.Thickness * 10000.0) as Soil.OC",
                            "[Soil].Nutrient.Microbial.C/[Soil].Nutrient.Humic.C as FBiom",
                            "[Soil].Nutrient.Inert.C/([Soil].Nutrient.Microbial.C + [Soil].Nutrient.Humic.C + [Soil].Nutrient.Inert.C) as FInert"
                          ],
