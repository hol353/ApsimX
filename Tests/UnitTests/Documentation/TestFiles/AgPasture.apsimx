                            {
                              "$type": "Models.Report, Models",
                              "VariableNames": [
                                "[Clock].Today as Date",
                                "[Clock].Today.Year as Year",
                                "",
                                "[Weather].Radn as SolarRadiation",
                                "[MicroClimate].NetRadiation",
                                "[MicroClimate].RadiationInterception as RadiationInterception",
                                "",
                                "// water outputs",
                                "[Weather].Rain as Rainfall",
                                "[Irrigation].IrrigationApplied as Irrigation",
                                "[Soil].SoilWater.Es as Evaporation",
                                "sum([AgPRyegrass].WaterUptake) as Transpiration",
                                "[Soil].SoilWater.Drainage as Drainage",
                                "[Soil].SoilWater.Runoff as Runoff",
                                "sum([Soil].Water.MM) as TotalSWC",
                                "sum([Soil].Physical.DULmm) as TotalDUL",
                                "sum([Soil].Physical.LL15mm) as TotalLL15",
                                "[Soil].Water.Volumetric[1] as TopLayerSWC",
                                "[Soil].Physical.DUL[1] as TopLayerDUL",
                                "[Soil].Physical.LL15[1] as TopLayerLL15",
                                "sum([AgPRyegrass].WaterAvailable) as SoilAvailableWater",
                                "",
                                "// nitrogen outputs",
                                "[Fertiliser].NitrogenApplied as FertiliserN",
                                "[DefoliationManager].Script.NReturnedInDung*10.0 as DungDepositedN",
                                "[DefoliationManager].Script.NReturnedInUrine*10.0 as UrineDepositedN",
                                "[AgPRyegrass].FixedN as FixedN",
                                "sum([Soil].Nutrient.DenitrifiedN) as DenitrifiedN",
                                "([Soil].SoilWater.LeachNH4 + [Soil].SoilWater.LeachNO3) as LeachedN",
                                "[AgPRyegrass].SoilUptakeN as UptakeN",
                                "sum([Soil].Nutrient.MineralisedN) as MineralisedSoilN",
                                "sum([SurfaceOrganicMatter].SurfaceResidue.Decomposition.MineralisedN) as MineralisedSurfOMN",
                                "(sum([Soil].Nutrient.MineralisedN) + sum([SurfaceOrganicMatter].SurfaceResidue.Decomposition.MineralisedN)) as NetMineralisedSoilN",
                                "([AgPRyegrass].LitterDepositionN+[AgPRyegrass].RootDetachedN) as DetachedN",
                                "",
                                "(sum([Soil].Urea.kgha) + sum([Soil].NH4.kgha) + sum([Soil].NO3.kgha)) as TotalMineralN",
                                "sum([Soil].Urea.kgha) as TotalUrea",
                                "sum([Soil].NH4.kgha) as TotalNH4",
                                "sum([Soil].NO3.kgha) as TotalNO3",
                                "[SurfaceOrganicMatter].N as TotalSurfOMN",
                                "sum([Soil].Nutrient.FOM.N) as TotalFOMN",
                                "sum([Soil].Nutrient.Humic.N) as TotalHumicN",
                                "sum([Soil].Nutrient.Microbial.N) as TotalMicrobialN",
                                "[AgPRyegrass].TotalN as TotalPlantN",
                                "",
                                "// plant outputs",
                                "[AgPRyegrass].TotalWt as TotalPlantBiomass",
                                "[AgPRyegrass].AboveGroundWt as AbovegroundPlantBiomass",
                                "[AgPRyegrass].BelowGroundWt as BelowgroundPlantBiomass",
                                "[AgPRyegrass].AboveGroundN/([AgPRyegrass].AboveGroundWt + 0.000000001) as AboveGroundNConc",
                                "[AgPRyegrass].BelowGroundN/([AgPRyegrass].BelowGroundWt + 0.000000001) as BelowGroundNConc",
                                "[AgPRyegrass].LAIGreen as LAIGreen",
                                "[AgPRyegrass].AboveGroundWt as AbovegroundRyegrassBiomass",
                                "[AgPRyegrass].BelowGroundWt as BelowgroundRyegrassBiomass",
                                "([AgPRyegrass].AboveGroundWt*0.0) as CloverContent",
                                "[AgPRyegrass].AboveGround.Wt as AbovegroundWt",
                                "[AgPRyegrass].AboveGround.N)/([AgPRyegrass].AboveGround.Wt + 0.000000001) as HerbageNConc",
                                "([AgPRyegrass].LitterDepositionWt+[AgPRyegrass].RootDetachedWt) as DetachedWt",
                                "",
                                "// defoliation outputs",
                                "[DefoliationManager].Script.ReturnedWt*10.0 as DungDepositedWt",
                                "[DefoliationManager].Script.DefoliatedWt*10.0 as DefoliatedWt",
                                "[DefoliationManager].Script.DefoliatedN*10.0 as DefoliatedN",
                                "[DefoliationManager].Script.DefoliatedN/([DefoliationManager].Script.DefoliatedWt + 0.000000001) as DefoliatedNConc",
                                "[AgPRyegrass].HarvestedWt as Defoliated2Wt"
                              ],
                              "EventNames": [
                                "[Clock].DoReport"
                              ],
                              "GroupByVariableName": null,
                              "Name": "BaseReport",
                              "ResourceName": null,
                              "Children": [],
                              "Enabled": true,
                              "ReadOnly": false
                            },
                            {
                              "$type": "Models.Report, Models",
                              "VariableNames": [
                                "[Clock].Today as Date",
                                "",
                                "Sum of ([Weather].Radn) from 1-jul to [Clock].Today as RadiationTotalCum",
                                "Sum of ([MicroClimate].RadiationInterception) from 1-jul to [Clock].Today as RadiationInterceptedCum",
                                "",
                                "// water outputs",
                                "Sum of ([Weather].Rain) from 1-jul to [Clock].Today as RainfallCum",
                                "Sum of ([Irrigation].IrrigationApplied) from 1-jul to [Clock].Today as IrrigationCum",
                                "Sum of ([Soil].SoilWater.Es) from 1-jul to [Clock].Today as EvaporationCum",
                                "Sum of (sum([AgPRyegrass].WaterUptake)) from 1-jul to [Clock].Today as TranspirationCum",
                                "Sum of ([Soil].SoilWater.Drainage) from 1-jul to [Clock].Today as DrainageCum",
                                "Sum of ([Soil].SoilWater.Runoff) from 1-jul to [Clock].Today as RunoffCum",
                                "",
                                "// nitrogen outputs",
                                "Sum of ([Fertiliser].NitrogenApplied) from 1-jul to [Clock].Today as FertiliserNCum",
                                "Sum of ([DefoliationManager].Script.NReturnedInDung*10.0) from 1-jul to [Clock].Today as DungDepositedNCum",
                                "Sum of ([DefoliationManager].Script.NReturnedInUrine*10.0) from 1-jul to [Clock].Today as UrineDepositedNCum",
                                "//Sum of ([AgPWhiteClover].FixedN) from 1-jul to [Clock].Today as FixedNCum",
                                "Sum of (sum([Soil].Nutrient.DenitrifiedN)) from 1-jul to [Clock].Today as DenitrifiedNCum",
                                "Sum of (([Soil].SoilWater.LeachNH4 + [Soil].SoilWater.LeachNO3)) from 1-jul to [Clock].Today as LeachedNCum",
                                "Sum of ([AgPRyegrass].SoilUptakeN) from 1-jul to [Clock].Today as UptakeNCum",
                                "Sum of (sum([Soil].Nutrient.MineralisedN) + sum([SurfaceOrganicMatter].SurfaceResidue.Decomposition.MineralisedN)) from 1-jul to [Clock].Today as NetMineralisedSoilNCum",
                                "Sum of ([AgPRyegrass].LitterDepositionN+[AgPRyegrass].RootDetachedN) from 1-jul to [Clock].Today as DetachedNCum",
                                "",
                                "// plant and defoliation outputs",
                                "Sum of ([AgPRyegrass].LitterDepositionWt+[AgPRyegrass].RootDetachedWt) from 1-Jun to [Clock].Today as DetachedWtCum",
                                "Sum of ([DefoliationManager].Script.ReturnedWt*10.0) from 1-Jun to [Clock].Today as DungDepositedWtCum",
                                "Sum of ([DefoliationManager].Script.DefoliatedWt*10.0) from 1-jul to [Clock].Today as DefoliatedWtCum",
                                "Sum of ([DefoliationManager].Script.DefoliatedN*10.0) from 1-jul to [Clock].Today as DefoliatedNCum",
                                "Sum of ([AgPRyegrass].HarvestedWt) from 1-jul to [Clock].Today as Defoliated2WtCum"
                              ],
                              "EventNames": [
                                "[Clock].DoReport"
                              ],
                              "GroupByVariableName": null,
                              "Name": "CumReport",
                              "ResourceName": null,
                              "Children": [],
                              "Enabled": true,
                              "ReadOnly": false
                            },
                            {
                              "$type": "Models.Report, Models",
                              "VariableNames": [
                                "[Clock].Today as Date",
                                "",
                                "[DefoliationManager].Script.DefoliatedWt as DefoliatedWt",
                                "Sum of ([DefoliationManager].Script.DefoliatedWt) from 1-Jul to [Clock].Today as CumDefoliatedWt",
                                "[DefoliationManager].Script.DefoliatedN as DefoliatedN",
                                "Sum of ([DefoliationManager].Script.DefoliatedN) from 1-Jul to [Clock].Today as CumDefoliatedN",
                                "",
                                "[AGPRyegrass].AboveGround.Wt as AboveGroundWt",
                                "[DefoliationManager].Script.DefoliatedN/([DefoliationManager].Script.DefoliatedWt + 0.000000001) as HerbageNConc",
                                "[AgPRyegrass].AboveGround.Wt * 0.0 as CloverContent"
