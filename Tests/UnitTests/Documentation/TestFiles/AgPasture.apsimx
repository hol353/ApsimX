                          "Children": [
                            {
                              "$type": "Models.Climate.Weather, Models",
                              "ConstantsFile": null,
                              "FileName": "VCS_Waerengaokuri.met",
                              "ExcelWorkSheetName": "",
                              "Name": "Weather",
                              "ResourceName": null,
                              "Children": [],
                              "Enabled": true,
