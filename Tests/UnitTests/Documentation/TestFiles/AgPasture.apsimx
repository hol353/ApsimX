                                      "Date": "2015-12-07",
                                      "Action": "[DefoliationManager].Script.Defoliate(defoliationType: \"Cut\", amountDM: 100, amountType: \"ResidualDM\", duration: 1)",
                                      "Line": "2015-12-07 [DefoliationManager].Script.Defoliate(defoliationType: \"Cut\", amountDM: 100, amountType: \"ResidualDM\", duration: 1)"
                                    },
