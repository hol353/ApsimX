                                  "Action": "[SimpleGrazing].GrazeToResidual(1000)",
                                  "Line": "1977-08-09 [SimpleGrazing].GrazeToResidual(1000)"
                                },
                                {
                                  "$type": "Models.Operation, Models",
                                  "Enabled": true,
                                  "Date": "1977-08-23",
                                  "Action": "[SimpleGrazing].GrazeToResidual(1000)",
                                  "Line": "1977-08-23 [SimpleGrazing].GrazeToResidual(1000)"
                                },
                                {
                                  "$type": "Models.Operation, Models",
                                  "Enabled": true,
                                  "Date": "1977-09-06",
                                  "Action": "[SimpleGrazing].GrazeToResidual(1000)",
                                  "Line": "1977-09-06 [SimpleGrazing].GrazeToResidual(1000)"
                                },
                                {
                                  "$type": "Models.Operation, Models",
                                  "Enabled": true,
                                  "Date": "1977-09-20",
                                  "Action": "[SimpleGrazing].GrazeToResidual(1000)",
                                  "Line": "1977-09-20 [SimpleGrazing].GrazeToResidual(1000)"
                                },
                                {
                                  "$type": "Models.Operation, Models",
                                  "Enabled": true,
                                  "Date": "1977-10-04",
                                  "Action": "[SimpleGrazing].GrazeToResidual(1000)",
                                  "Line": "1977-10-04 [SimpleGrazing].GrazeToResidual(1000)"
                                },
                                {
                                  "$type": "Models.Operation, Models",
                                  "Enabled": true,
                                  "Date": "1977-10-18",
                                  "Action": "[SimpleGrazing].GrazeToResidual(1000)",
                                  "Line": "1977-10-18 [SimpleGrazing].GrazeToResidual(1000)"
