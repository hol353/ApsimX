                        {
                          "$type": "Models.Report, Models",
                          "VariableNames": [
                            "[Clock].Today as Date",
                            "([AGPRyegrass].TotalWt + [AGPWhiteClover].TotalWt) as TotalPlantWt",
                            "([AGPRyegrass].AboveGroundWt + [AGPWhiteClover].AboveGroundWt) as TotalPlantWt",
                            "([AGPRyegrass].HarvestedWt + [AGPWhiteClover].HarvestedWt) as HarvestedWt",
                            "Sum of ([AGPRyegrass].HarvestedWt + [AGPWhiteClover].HarvestedWt) from 1-Jul to [Clock].Today as HarvestedWtCum",
                            "Sum of ([AGPRyegrass].HarvestedN + [AGPWhiteClover].HarvestedN) from 1-Jul to [Clock].Today as HarvestedNCum",
                            "([AGPWhiteClover].HarvestedWt / ([AGPWhiteClover].HarvestedWt + [AGPRyegrass].HarvestedWt + 0.000001)) as CloverContentHarvested",
                            "[AGPRyegrass].AboveGroundLiveWt as AboveGroundLiveWt_Ryegrass",
                            "[AGPWhiteClover].AboveGroundLiveWt as AboveGroundLiveWt_WClover",
                            "",
                            "",
                            "[Irrigation].IrrigationApplied as Irrigation",
                            "(sum([Soil].Urea.kgha) + sum([Soil].NH4.kgha) + sum([Soil].NO3.kgha)) as TotalSoilMinN",
                            "Sum of [AGPWhiteClover].FixedN from 1-Jul to [Clock].Today as AnnualFixed",
                            "Sum of ([SimpleGrazing].AmountUrineNReturned + [SimpleGrazing].AmountDungNReturned) from 1-Jul to [Clock].Today as ReturnedNCum",
                            "([AGPryegrass].SoilUptakeN + [AGPWhiteClover].SoilUptakeN) as TotalUptake",
                            "Sum of ([AGPryegrass].SoilUptakeN + [AGPWhiteClover].SoilUptakeN) from 1-Jul to [Clock].Today as AnnualTotalUptake"
                          ],
                          "EventNames": [
                            "[Clock].EndOfDay"
                          ],
                          "GroupByVariableName": null,
                          "Name": "DailyReport",
                          "ResourceName": null,
                          "Children": [],
                          "Enabled": true,
                          "ReadOnly": false
                        },
                        {
                          "$type": "Models.Report, Models",
                          "VariableNames": [
                            "[Clock].Today as Date",
                            "[Clock].Today.Year as Year",
                            "[Weather].Season as Season",
                            "sum of [AGPWhiteClover].HarvestedWt from [Clock].StartOfSimulation to [Clock].EndOfSimulation as WhiteClover",
                            "sum of [AGPRyegrass].HarvestedWt from [Clock].StartOfSimulation to [Clock].EndOfSimulation as Ryegrass",
                            "mean of ([AGPWhiteClover].HarvestedWt / ([AGPWhiteClover].HarvestedWt + [AGPRyegrass].HarvestedWt + 0.000001)) on [SimpleGrazing].Grazed from [Clock].StartOfSimulation to [Clock].EndOfSimulation as PropCloverHarvested"
                          ],
                          "EventNames": [
                            "[Clock].EndOfSimulation"
                          ],
                          "GroupByVariableName": "[Weather].Season",
                          "Name": "SeasonalReport",
                          "ResourceName": null,
                          "Children": [],
                          "Enabled": true,
                          "ReadOnly": false
                        },
                        {
                          "$type": "Models.Report, Models",
                          "VariableNames": [
                            "[Clock].Today as Date",
                            "sum of [AGPRyegrass].HarvestedWt+[AGPWhiteClover].HarvestedWt from [Annualreport].DayAfterLastOutput to [Clock].Today as AnnualHarvestedWt",
                            "sum of [Irrigation].IrrigationApplied from [Annualreport].DayAfterLastOutput to [Clock].Today as AnnualIrrigation"
                          ],
                          "EventNames": [
