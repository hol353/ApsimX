                                    }
                                  ],
                                  "Name": "DefoliationSchedule",
                                  "ResourceName": null,
                                  "Children": [],
                                  "Enabled": true,
                                  "ReadOnly": false
                                },
                                {
                                  "$type": "Models.Operations, Models",
                                  "OperationsList": [
                                    {
                                      "$type": "Models.Operation, Models",
                                      "Enabled": true,
                                      "Date": "2016-02-18",
                                      "Action": "[Irrigation].Apply(amount: 16)",
                                      "Line": "2016-02-18 [Irrigation].Apply(amount: 16)"
