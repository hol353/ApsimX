                        {
                          "$type": "Models.Report, Models",
                          "VariableNames": [
                            "[Clock].Today as Date",
                            "[Clock].Today.Year as Year",
                            "",
                            "[Weather].Radn as RadiationTotal",
                            "[MicroClimate].RadiationInterception as RadiationIntercepted",
                            "",
                            "// water outputs",
                            "[Weather].Rain as Rainfall",
                            "[Irrigation].IrrigationApplied as Irrigation",
                            "[Soil].SoilWater.Es as Evaporation",
                            "(sum([AgPRyegrass].WaterUptake) + sum([AgPWhiteClover].WaterUptake)) as Transpiration",
                            "[Soil].SoilWater.Drainage as Drainage",
                            "[Soil].SoilWater.Runoff as Runoff",
                            "sum([Soil].Water.MM) as TotalSWC",
                            "sum([Soil].Physical.DULmm) as TotalDUL",
                            "sum([Soil].Physical.LL15mm) as TotalLL15",
                            "[Soil].Water.Volumetric[1] as TopLayerSWC",
                            "[Soil].Physical.DUL[1] as TopLayerDUL",
                            "[Soil].Physical.LL15[1] as TopLayerLL15",
                            "(sum([AgPRyegrass].WaterAvailable) + sum([AgPWhiteClover].WaterAvailable)) as SoilAvailableWater",
                            "",
                            "// nitrogen outputs",
                            "[Fertiliser].NitrogenApplied as FertiliserN",
                            "[DefoliationManager].Script.NReturnedInDung*10.0 as DungDepositedN",
                            "[DefoliationManager].Script.NReturnedInUrine*10.0 as UrineDepositedN",
                            "[AgPWhiteClover].FixedN as FixedN",
                            "sum([Soil].Nutrient.DenitrifiedN) as DenitrifiedN",
                            "([Soil].SoilWater.LeachNH4 + [Soil].SoilWater.LeachNO3) as LeachedN",
                            "([AgPRyegrass].SoilUptakeN + [AgPWhiteClover].SoilUptakeN) as UptakeN",
                            "sum([Soil].Nutrient.MineralisedN) as MineralisedSoilN",
                            "sum([SurfaceOrganicMatter].SurfaceResidue.Decomposition.MineralisedN) as MineralisedSurfOMN",
                            "(sum([Soil].Nutrient.MineralisedN) + sum([SurfaceOrganicMatter].SurfaceResidue.Decomposition.MineralisedN)) as NetMineralisedSoilN",
                            "([AgPRyegrass].LitterDepositionN+[AgPRyegrass].RootDetachedN+[AgPWhiteClover].LitterDepositionN+[AgPWhiteClover].RootDetachedN) as DetachedN",
                            "",
                            "(sum([Soil].Urea.kgha) + sum([Soil].NH4.kgha) + sum([Soil].NO3.kgha)) as TotalMineralN",
                            "sum([Soil].Urea.kgha) as TotalUrea",
                            "sum([Soil].NH4.kgha) as TotalNH4",
                            "sum([Soil].NO3.kgha) as TotalNO3",
                            "[SurfaceOrganicMatter].N as TotalSurfOMN",
                            "sum([Soil].Nutrient.FOM.N) as TotalFOMN",
                            "sum([Soil].Nutrient.Humic.N) as TotalHumicN",
                            "sum([Soil].Nutrient.Microbial.N) as TotalMicrobialN",
                            "([AgPRyegrass].TotalN + [AgPWhiteClover].TotalN) as TotalPlantN",
                            "",
                            "// plant outputs",
                            "([AgPRyegrass].TotalWt + [AgPWhiteClover].TotalWt) as TotalPlantBiomass",
                            "([AgPRyegrass].AboveGroundWt + [AgPWhiteClover].AboveGroundWt) as AbovegroundPlantBiomass",
                            "([AgPRyegrass].BelowGroundWt + [AgPWhiteClover].BelowGroundWt) as BelowgroundPlantBiomass",
                            "([AgPRyegrass].AboveGroundN + [AgPWhiteClover].AboveGroundN)/([AgPRyegrass].AboveGroundWt + [AgPWhiteClover].AboveGroundWt + 0.000000001) as AboveGroundNConc",
                            "([AgPRyegrass].BelowGroundN + [AgPWhiteClover].BelowGroundN)/([AgPRyegrass].BelowGroundWt + [AgPWhiteClover].BelowGroundWt + 0.000000001) as BelowGroundNConc",
                            "[AgPRyegrass].LAIGreen + [AgPWhiteClover].LAIGreen as LAIGreen",
                            "[AgPRyegrass].LAIDead + [AgPWhiteClover].LAIDead as LAIDead",
                            "[AgPWhiteClover].AboveGroundWt/([AgPRyegrass].AboveGroundWt + [AgPWhiteClover].AboveGroundWt + 0.000000001) as CloverContent",
                            "([AgPRyegrass].LitterDepositionWt+[AgPRyegrass].RootDetachedWt+[AgPWhiteClover].LitterDepositionWt+[AgPWhiteClover].RootDetachedWt) as DetachedWt",
                            "",
                            "[AgPRyegrass].AboveGroundWt as AbovegroundRyegrassBiomass",
                            "[AgPWhiteClover].AboveGroundWt as AbovegroundWhiteCloverBiomass",
                            "[AgPRyegrass].BelowGroundWt as BelowgroundRyegrassBiomass",
                            "[AgPWhiteClover].BelowGroundWt as BelowgroundWhiteCloverBiomass",
                            "",
                            "// defoliation outputs",
                            "[DefoliationManager].Script.ReturnedWt*10.0 as DungDepositedWt",
                            "[DefoliationManager].Script.DefoliatedWt*10.0 as DefoliatedWt",
                            "[DefoliationManager].Script.DefoliatedN*10.0 as DefoliatedN",
                            "[DefoliationManager].Script.DefoliatedN/([DefoliationManager].Script.DefoliatedWt + 0.000000001) as DefoliatedNConc",
                            "[AgPWhiteClover].HarvestedWt/([AgPRyegrass].HarvestedWt + [AgPWhiteClover].HarvestedWt + 0.000000001) as DefoliatedCloverContent",
                            "([AgPRyegrass].HarvestedWt + [AgPWhiteClover].HarvestedWt) as Defoliated2Wt"
                          ],
                          "EventNames": [
                            "[Clock].DoReport"
                          ],
                          "GroupByVariableName": null,
                          "Name": "BaseReport",
                          "ResourceName": null,
                          "Children": [],
                          "Enabled": true,
                          "ReadOnly": false
                        },
                        {
                          "$type": "Models.Report, Models",
                          "VariableNames": [
                            "[Clock].Today as Date",
                            "",
                            "Sum of ([Weather].Radn) from 1-jul to [Clock].Today as RadiationTotalCum",
                            "Sum of ([MicroClimate].RadiationInterception) from 1-jul to [Clock].Today as RadiationInterceptedCum",
                            "",
                            "// water outputs",
                            "Sum of ([Weather].Rain) from 1-Jun to [Clock].Today as RainfallCum",
                            "Sum of ([Irrigation].IrrigationApplied) from 1-Jun to [Clock].Today as IrrigationCum",
                            "Sum of ([Soil].SoilWater.Es) from 1-Jun to [Clock].Today as EvaporationCum",
                            "Sum of ((sum([AgPRyegrass].WaterUptake) + sum([AgPWhiteClover].WaterUptake))) from 1-Jun to [Clock].Today as TranspirationCum",
                            "Sum of ([Soil].SoilWater.Drainage) from 1-Jun to [Clock].Today as DrainageCum",
                            "Sum of ([Soil].SoilWater.Runoff) from 1-Jun to [Clock].Today as RunoffCum",
                            "",
                            "// nitrogen outputs",
                            "Sum of ([Fertiliser].NitrogenApplied) from 1-Jun to [Clock].Today as FertiliserNCum",
                            "Sum of ([DefoliationManager].Script.NReturnedInDung*10.0) from 1-Jun to [Clock].Today as DungDepositedNCum",
                            "Sum of ([DefoliationManager].Script.NReturnedInUrine*10.0) from 1-Jun to [Clock].Today as UrineDepositedNCum",
                            "Sum of ([AgPWhiteClover].FixedN) from 1-Jun to [Clock].Today as FixedNCum",
                            "Sum of (sum([Soil].Nutrient.DenitrifiedN)) from 1-Jun to [Clock].Today as DenitrifiedNCum",
                            "Sum of (([Soil].SoilWater.LeachNH4 + [Soil].SoilWater.LeachNO3)) from 1-Jun to [Clock].Today as LeachedNCum",
                            "Sum of (([AgPRyegrass].SoilUptakeN + [AgPWhiteClover].SoilUptakeN)) from 1-Jun to [Clock].Today as UptakeNCum",
                            "Sum of (sum([Soil].Nutrient.MineralisedN) + sum([SurfaceOrganicMatter].SurfaceResidue.Decomposition.MineralisedN)) from 1-Jun to [Clock].Today as NetMineralisedSoilNCum",
                            "Sum of ([AgPRyegrass].LitterDepositionN+[AgPRyegrass].RootDetachedN+[AgPWhiteClover].LitterDepositionN+[AgPWhiteClover].RootDetachedN) from 1-Jun to [Clock].Today as DetachedNCum",
                            "",
                            "// plant and defoliation outputs",
                            "Sum of ([AgPRyegrass].LitterDepositionWt+[AgPRyegrass].RootDetachedWt+[AgPWhiteClover].LitterDepositionWt+[AgPWhiteClover].RootDetachedWt) from 1-Jun to [Clock].Today as DetachedWtCum",
                            "Sum of ([DefoliationManager].Script.ReturnedWt*10.0) from 1-Jun to [Clock].Today as DungDepositedWtCum",
                            "Sum of ([DefoliationManager].Script.DefoliatedWt*10.0) from 1-Jun to [Clock].Today as DefoliatedWtCum",
                            "Sum of ([DefoliationManager].Script.DefoliatedN*10.0) from 1-Jun to [Clock].Today as DefoliatedNCum",
                            "Sum of ([AgPRyegrass].HarvestedWt + [AgPWhiteClover].HarvestedWt) from 1-Jun to [Clock].Today as Defoliated2WtCum"
                          ],
                          "EventNames": [
                            "[Clock].DoReport"
                          ],
                          "GroupByVariableName": null,
                          "Name": "CumReport",
                          "ResourceName": null,
                          "Children": [],
                          "Enabled": true,
                          "ReadOnly": false
                        },
                        {
                          "$type": "Models.Report, Models",
                          "VariableNames": [
                            "[Clock].Today as Date",
                            "",
                            "([DefoliationManager].Script.DefoliatedWt*10.0) as DefoliatedWt",
                            "([AGPRyegrass].HarvestedWt + [AGPWhiteClover].HarvestedWt) as Defoliated2Wt",
                            "Sum of ([DefoliationManager].Script.DefoliatedWt*10.0) from 1-Jun to [Clock].Today as CumDefoliatedWt",
                            "Sum of ([AGPRyegrass].HarvestedWt + [AGPWhiteClover].HarvestedWt) from 1-Jun to [Clock].Today as CumDefoliated2Wt",
                            "",
                            "([AGPRyegrass].AboveGroundWt + [AGPWhiteClover].AboveGroundWt) as AboveGroundWt",
                            "[AgPWhiteClover].AboveGroundWt/([AgPRyegrass].AboveGroundWt + [AgPWhiteClover].AboveGroundWt + 0.000000001) as CloverContent"
                          ],
                          "EventNames": [
                            "[DefoliationManager].Script.DefoliationHappenedToday"
                          ],
                          "GroupByVariableName": null,
                          "Name": "ValidationReport",
                          "ResourceName": null,
                          "Children": [],
