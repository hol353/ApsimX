                                  "Action": "[DefoliationManager].Script.Defoliate(defoliationType: \"Graze\", amountDM: 100, amountType: \"ResidualDM\", duration: 1)",
                                  "Line": "2002-10-22 [DefoliationManager].Script.Defoliate(defoliationType: \"Graze\", amountDM: 100, amountType: \"ResidualDM\", duration: 1)"
                                },
                                {
                                  "$type": "Models.Operation, Models",
                                  "Enabled": true,
                                  "Date": "2002-12-02",
                                  "Action": "[DefoliationManager].Script.Defoliate(defoliationType: \"Graze\", amountDM: 100, amountType: \"ResidualDM\", duration: 1)",
                                  "Line": "2002-12-02 [DefoliationManager].Script.Defoliate(defoliationType: \"Graze\", amountDM: 100, amountType: \"ResidualDM\", duration: 1)"
                                },
                                {
                                  "$type": "Models.Operation, Models",
                                  "Enabled": true,
                                  "Date": "2003-01-08",
                                  "Action": "[DefoliationManager].Script.Defoliate(defoliationType: \"Graze\", amountDM: 100, amountType: \"ResidualDM\", duration: 1)",
                                  "Line": "2003-01-08 [DefoliationManager].Script.Defoliate(defoliationType: \"Graze\", amountDM: 100, amountType: \"ResidualDM\", duration: 1)"
                                },
                                {
                                  "$type": "Models.Operation, Models",
                                  "Enabled": true,
                                  "Date": "2003-02-07",
                                  "Action": "[DefoliationManager].Script.Defoliate(defoliationType: \"Graze\", amountDM: 100, amountType: \"ResidualDM\", duration: 1)",
                                  "Line": "2003-02-07 [DefoliationManager].Script.Defoliate(defoliationType: \"Graze\", amountDM: 100, amountType: \"ResidualDM\", duration: 1)"
                                },
                                {
                                  "$type": "Models.Operation, Models",
                                  "Enabled": true,
                                  "Date": "2003-04-02",
                                  "Action": "[DefoliationManager].Script.Defoliate(defoliationType: \"Graze\", amountDM: 100, amountType: \"ResidualDM\", duration: 1)",
                                  "Line": "2003-04-02 [DefoliationManager].Script.Defoliate(defoliationType: \"Graze\", amountDM: 100, amountType: \"ResidualDM\", duration: 1)"
