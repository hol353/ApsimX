                                  "Line": "2002-03-12 [DefoliationManager].Script.Defoliate(defoliationType: \"Graze\", amountDM: 100, amountType: \"ResidualDM\", duration: 1)"
                                },
                                {
                                  "$type": "Models.Operation, Models",
                                  "Enabled": true,
