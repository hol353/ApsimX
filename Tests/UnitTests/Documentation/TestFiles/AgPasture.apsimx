                    {
                      "$type": "Models.Manager, Models",
                      "CodeArray": [
                        "using Newtonsoft.Json;",
                        "using System;",
                        "using System.Xml.Serialization;",
                        "using Models.Core;",
                        "using Models.PMF;",
                        "using Models.Soils;",
                        "using Models.Soils.Nutrients;",
                        "using APSIM.Shared.Utilities;",
                        "using Models.Climate;",
                        "",
                        "namespace Models",
                        "{",
                        "    [Serializable]",
                        "    public class Script : Model",
                        "    {",
                        "        // - Links to APSIM models",
                        "        [Link] Zone zone;",
                        "        [Link] Clock clock;",
                        "        [Link] Weather weather;",
                        "        [Link] ISummary summary = null;",
                        "",
                        "        // - Paramters for this manager",
                        "        [Description(\"Enable? Set to 'No' to completely disable this manager\")] public bool AllowControl { get; set; }",
                        "",
                        "        [Separator(\"General settings\")]",
                        "        [Description(\"Start the climate controls beginning on date (dd/mmm/yyyy): \")] public DateTime EnableDate { get; set; }",
                        "        [Description(\"Implement climate control only during part of the year?\")] public bool WithinYearControl { get; set; }",
                        "        [Description(\"Within each year, the first day to start the climate controls is (dd-mmm)\")] public string ControlStart { get; set; }",
                        "        [Description(\"Within each year, end last day of climate control is (dd-mmm)\")] public string ControlEnd { get; set; }",
                        "",
                        "        [Separator(\"Rainfall\")]",
                        "        [Description(\"Rainfall multiplier (-): \")] public double RainfallMultiplier { get; set; }",
                        "        [Description(\"Rainfall addition (mm): \")] public double RainfallAddition { get; set; }",
                        "",
                        "        [Separator(\"Radiation\")]",
                        "        [Description(\"Radiation multiplier (-): \")] public double RadiationMultiplier { get; set; }",
                        "        [Description(\"Radiation addition (MJ/m2): \")] public double RadiationAddition { get; set; }",
                        "",
                        "        [Separator(\"Minimum temperature\")]",
                        "        [Description(\"Minimum temperature multiplier (-): \")] public double MinTMultiplier { get; set; }",
                        "        [Description(\"Minimum temperature addition (C): \")] public double MinTAddition { get; set; }",
                        "",
                        "        [Separator(\"Maximum temperature\")]",
                        "        [Description(\"Maximum temperature multiplier (-): \")] public double MaxTMultiplier { get; set; }",
                        "        [Description(\"Maximum temperature addition (C): \")] public double MaxTAddition { get; set; }",
                        "",
                        "        [Separator(\"Wind speed\")]",
                        "        [Description(\"Wind speed multiplier (-): \")] public double WindMultiplier { get; set; }",
                        "        [Description(\"Wind speed addition (m/s): \")] public double WindAddition { get; set; }",
                        "",
                        "        [Separator(\"Vapour pressure\")]",
                        "        [Description(\"Vapour pressure multiplier (-): \")] public double VPMultiplier { get; set; }",
                        "        [Description(\"Vapour pressure addition (hPa): \")] public double VPAddition { get; set; }",
                        "",
                        "        [JsonIgnore] public bool DoControl { get; set; }",
                        "        [JsonIgnore] public int DoControlInt { get; set; }",
                        "",
                        "        [EventSubscribe(\"PreparingNewWeatherData\")] private void OnDoManagement(object sender, EventArgs e)",
                        "        {",
                        "            // Check if this manager is enabled",
                        "            if ((AllowControl) && (clock.Today >= EnableDate))",
                        "            {",
                        "                DoControl = true;",
                        "                if (WithinYearControl)",
                        "                    DoControl = DateUtilities.WithinDates(ControlStart, clock.Today, ControlEnd); ",
                        "            }",
                        "",
                        "            if (DoControl)",
                        "                DoControlInt = 1;",
                        "            else",
                        "                DoControlInt = 0;",
                        "",
                        "            if (DoControl)",
                        "            {",
                        "                // do the weather alterations ",
                        "                weather.Rain = RainfallMultiplier * weather.Rain + RainfallAddition;",
                        "                weather.Radn = RadiationMultiplier * weather.Radn + RadiationAddition;",
                        "                weather.MinT = MinTMultiplier * weather.MinT + MinTAddition;",
                        "                weather.MaxT = MaxTMultiplier * weather.MaxT + MaxTAddition;",
                        "                weather.Wind = WindMultiplier * weather.Wind + WindAddition;",
                        "                weather.VP = VPMultiplier * weather.VP + VPAddition;",
                        "            }",
                        "        }",
                        "    }",
                        "}"
                      ],
                      "Parameters": [
                        {
                          "Key": "AllowControl",
                          "Value": "True"
                        },
                        {
                          "Key": "EnableDate",
                          "Value": "01/01/1975 00:00:00"
                        },
                        {
                          "Key": "WithinYearControl",
                          "Value": "False"
                        },
                        {
                          "Key": "ControlStart",
                          "Value": ""
                        },
                        {
                          "Key": "ControlEnd",
                          "Value": ""
                        },
                        {
                          "Key": "RainfallMultiplier",
                          "Value": "0"
                        },
                        {
                          "Key": "RainfallAddition",
                          "Value": "0.98"
                        },
                        {
                          "Key": "RadiationMultiplier",
                          "Value": "0"
                        },
                        {
                          "Key": "RadiationAddition",
                          "Value": "0"
                        },
                        {
                          "Key": "MinTMultiplier",
                          "Value": "0"
                        },
                        {
                          "Key": "MinTAddition",
                          "Value": "0"
                        },
                        {
                          "Key": "MaxTMultiplier",
                          "Value": "0"
                        },
                        {
                          "Key": "MaxTAddition",
                          "Value": "0"
                        },
                        {
                          "Key": "WindMultiplier",
                          "Value": "0"
                        },
                        {
                          "Key": "WindAddition",
                          "Value": "0"
                        },
                        {
                          "Key": "VPMultiplier",
                          "Value": "0"
                        },
                        {
                          "Key": "VPAddition",
                          "Value": "0"
                        }
                      ],
                      "Name": "ClimateController",
                      "ResourceName": null,
                      "Children": [],
                      "Enabled": true,
                      "ReadOnly": false
                    },
                    {
                      "$type": "Models.Core.Zone, Models",
                      "Area": 1.0,
                      "Slope": 0.0,
                      "AspectAngle": 0.0,
                      "Altitude": 50.0,
                      "Name": "Field",
                      "ResourceName": null,
                      "Children": [
                        {
                          "$type": "Models.Core.Folder, Models",
                          "ShowInDocs": false,
                          "GraphsPerPage": 6,
                          "Name": "Management",
                          "ResourceName": null,
                          "Children": [
                            {
                              "$type": "Models.Manager, Models",
                              "CodeArray": [
                                "using Newtonsoft.Json;",
                                "using Models.PMF.Phen;",
                                "using System;",
                                "using Models.Core;",
                                "using Models.PMF;",
                                "using Models.Soils;",
                                "using System.Xml.Serialization;",
                                "using APSIM.Shared.Utilities;",
                                "using Models.Interfaces;",
                                "",
                                "        ",
                                "namespace Models",
                                "{",
                                "    [Serializable] ",
                                "    [System.Xml.Serialization.XmlInclude(typeof(Model))]",
                                "    public class Script : Model",
                                "    {",
                                "        [Link] private ISummary summary;",
                                "        [Link] private Irrigation Irrigation;",
                                "        [Link] private Clock Clock;",
                                "        [Link] private Soil Soil;",
                                "        [Link(IsOptional = true)] private IPlant existingCrop;",
                                "        private DateTime StartDate;",
                                "        private DateTime EndDate;",
                                "        private double TopDUL;",
                                "        private double TopLL;",
                                "        private int nLayers;",
                                "        [Link(IsOptional = true)]",
                                "        private Phenology phenology;",
                                "        [Link]",
                                "        private IPhysical soilPhysical;",
                                "        [Link]",
                                "        private ISoilWater waterBalance;",
                                "        //Communication to other modules",
                                "       ",
                                "        //User inputs from properties tab",
                                "        [Description(\"Turn irrigation on?\")]",
                                "        public bool allowIrrigation { get; set; }",
                                "        [Description(\"Start of irrigation season (dd-MMM)\")]",
                                "        public string seasonStart { get; set; }",
                                "        [Description(\"End of irrigation season (dd-MMM)\")]",
                                "        public string seasonEnd { get; set; }",
                                "        [Description(\"Season allocation (mm)\")]",
                                "        public double seasonsAllocation { get; set; }",
                                "        [Description(\"Deficit to trigger irrigation (% PAWC)\")]",
                                "        public double triggerDeficit { get; set; }",
                                "        [Description(\"Deficit to stop irrigaton (% PAWC)\")]",
                                "        public double targetDeficit { get; set; }",
                                "        [Description(\"Minimum days for irrigation to return\")]",
                                "        public double returndays { get; set; }",
                                "        [Description(\"Maximum irrigation application (mm/day)\")]",
                                "        public double maximumAmount { get; set; }",
                                "        [Description(\"Depth to calculate PAWC (mm)\")]",
                                "        public double depthPAWC { get; set; }",
                                "",
                                "        //Class members",
                                "        [JsonIgnore] public double TopSWdeficit { get; set; }",
                                "        [JsonIgnore] public double TopSWC { get; set; }",
                                "        [JsonIgnore] public double DaysSinceIrrigation { get; set; }",
                                "        [JsonIgnore] public double AmountToApply { get; set; }",
                                "        [JsonIgnore] public double SeasonAppliedAmount { get; set; }",
                                "        ",
                                "        private bool IrrigationIsAllowed { get; set; }",
                                "        private bool SeasonIsOpen { get; set; }",
                                "        private bool CropIsActive { get; set; }",
                                "        private bool IrrigatorIsAvailable { get; set; }",
                                "        private bool SoilIsDry { get; set; }",
                                "",
                                "    ",
                                "        //Calculate static soil variables",
                                "        [EventSubscribe(\"StartOfSimulation\")]",
                                "        private void OnStartOfSimulation(object sender, EventArgs e)",
                                "        {   ",
                                "            //Set the season dates",
                                "            StartDate = DateTime.Parse(seasonStart + \"-\" + Clock.Today.Year.ToString());",
                                "            EndDate = DateTime.Parse(seasonEnd + \"-\" + Clock.Today.Year.ToString());",
                                "            ",
                                "            //Can we irrigate at all?",
                                "            IrrigationIsAllowed = false; ",
                                "            if (allowIrrigation)",
                                "                IrrigationIsAllowed = true; ",
                                "",
                                "            //Calculate soil water variables",
                                "            double depthFromSurface = 0.0;",
                                "            double fracLayer = 0.0;",
                                "            nLayers = soilPhysical.Thickness.Length;",
                                "            for (int layer = 0; layer < nLayers; layer++)",
                                "            {",
                                "                fracLayer = Math.Min(1.0, (depthPAWC - depthFromSurface) / soilPhysical.Thickness[layer]);",
                                "                TopLL += soilPhysical.LL15mm[layer] * fracLayer;",
                                "                TopDUL += soilPhysical.DULmm[layer] * fracLayer;",
                                "                depthFromSurface += soilPhysical.Thickness[layer];",
                                "                if (depthFromSurface >= depthPAWC)",
                                "                    layer = nLayers;",
                                "            }",
                                "        }",
                                "             ",
                                "        //Determine daily requirement for irrigation",
                                "        [EventSubscribe(\"StartOfDay\")]",
                                "        private void OnStartOfDay(object sender, EventArgs e)",
                                "        {",
                                "            //Can we irrigate today?          ",
                                "            SeasonIsOpen = isBetween(Clock.Today, StartDate, EndDate);",
                                "",
                                "            //Is there a crop in the ground that needs irrigation?",
                                "            CropIsActive = false;",
                                "            if ((existingCrop != null) && (existingCrop.IsAlive))",
                                "                CropIsActive = true;",
                                "            //if ((phenology.Stage >= 3.0) && (phenology.Stage < 6.0))",
                                "          ",
                                "            //Is the irrigator available?",
                                "            IrrigatorIsAvailable = false;",
                                "            DaysSinceIrrigation += 1;",
                                "            if (DaysSinceIrrigation >= returndays)",
                                "                IrrigatorIsAvailable = true;",
                                "          ",
                                "            //Is the soil dry enough to require irrigation?",
                                "            SoilIsDry = false;",
                                "            double depthFromSurface = 0.0;",
                                "            double fracLayer = 0.0;",
                                "            TopSWC = 0.0;",
                                "            for (int layer = 0; layer < nLayers; layer++)",
                                "            //for (int layer = 0; depthFromSurface < depthPAWC + soilPhysical.Thickness[layer]; layer++)",
                                "            {",
                                "                fracLayer = Math.Min(1.0, (depthPAWC - depthFromSurface) / soilPhysical.Thickness[layer]);",
                                "                TopSWC += waterBalance.SWmm[layer] * fracLayer;",
                                "                depthFromSurface += soilPhysical.Thickness[layer];",
                                "                if (depthFromSurface >= depthPAWC)",
                                "                    layer = nLayers;",
                                "            }",
                                "            ",
                                "            TopSWdeficit = TopSWC - TopDUL;",
                                "            if (Math.Max(0.0, -TopSWdeficit) >= (TopDUL - TopLL) * (100 - triggerDeficit) / 100)",
                                "                SoilIsDry = true;",
                                "                ",
                                "            //Are all the conditions ratifying irrigation",
                                "            if (IrrigationIsAllowed && SeasonIsOpen && CropIsActive && IrrigatorIsAvailable && SoilIsDry)",
                                "            {",
                                "                //Lets bloody well irrigate then!!!!",
                                "                AmountToApply = TopDUL * targetDeficit / 100 - TopSWC;",
                                "                AmountToApply = Math.Max(0.0, Math.Min(AmountToApply, seasonsAllocation - SeasonAppliedAmount));",
                                "                Irrigation.Apply(AmountToApply);",
                                "                DaysSinceIrrigation = 0;",
                                "                SeasonAppliedAmount += AmountToApply;",
                                "            }",
                                "        }",
                                "        ",
                                "        ///Checks whether theDate is between iniDate and endDate (non-year specific)",
                                "        private bool isBetween(DateTime theDay, DateTime iniDate, DateTime endDate)",
                                "        {",
                                "            bool result = false;",
                                "            if (iniDate.DayOfYear < endDate.DayOfYear)",
                                "            {",
                                "                // period is within one year, ex: summer in the northern hemisphere",
                                "                if ((theDay.DayOfYear >= iniDate.DayOfYear) && (theDay.DayOfYear <= endDate.DayOfYear))",
                                "                    result = true;",
                                "            }",
                                "            else",
                                "            {",
                                "                // period goes over the end of the year, ex: summer in the southern hemisphere",
                                "                if ((theDay.DayOfYear >= iniDate.DayOfYear) || (theDay.DayOfYear <= endDate.DayOfYear))",
                                "                    result = true;",
                                "            }",
                                "            ",
                                "            return result;",
                                "        }",
                                "    }",
                                "}"
                              ],
                              "Parameters": [
                                {
                                  "Key": "allowIrrigation",
                                  "Value": "False"
                                },
                                {
                                  "Key": "seasonStart",
                                  "Value": "15-Aug"
                                },
                                {
                                  "Key": "seasonEnd",
                                  "Value": "30-May"
                                },
                                {
                                  "Key": "seasonsAllocation",
                                  "Value": "10000"
                                },
                                {
                                  "Key": "triggerDeficit",
                                  "Value": "50"
                                },
                                {
                                  "Key": "targetDeficit",
                                  "Value": "99"
                                },
                                {
                                  "Key": "returndays",
                                  "Value": "1"
                                },
                                {
                                  "Key": "maximumAmount",
                                  "Value": "30"
                                },
                                {
                                  "Key": "depthPAWC",
                                  "Value": "300"
                                }
                              ],
                              "Name": "AutomaticIrrigation",
                              "ResourceName": null,
                              "Children": [],
                              "Enabled": true,
                              "ReadOnly": false
                            },
                            {
                              "$type": "Models.Operations, Models",
                              "OperationsList": null,
                              "Name": "IrrigationSchedule",
                              "ResourceName": null,
                              "Children": [],
                              "Enabled": true,
                              "ReadOnly": false
                            },
                            {
                              "$type": "Models.Operations, Models",
                              "OperationsList": null,
                              "Name": "Cutting",
                              "ResourceName": null,
                              "Children": [],
                              "Enabled": true,
                              "ReadOnly": false
                            },
                            {
                              "$type": "Models.Manager, Models",
                              "CodeArray": [
                                "using Newtonsoft.Json;",
                                "using Models.AgPasture;",
                                "using System;",
                                "using System.Xml.Serialization;",
                                "using System.Collections.Generic;",
                                "using System.Linq;",
                                "using Models.Core;",
                                "using Models.PMF;",
                                "using Models.Soils;",
                                "using APSIM.Shared.Utilities;",
                                "using Models.Utilities;",
                                "using Models.Interfaces;",
                                "",
                                "",
                                "namespace Models",
                                "{",
                                "    [Serializable]",
                                "    public class Script : Model",
                                "    {",
                                "        [Link] private Zone zone;",
                                "        [Link] private Simulation Simulation;",
                                "        [Link] private Clock Clock;",
                                "        [Link] private Fertiliser fertiliser;",
                                "        [Link] private Soil mySoil;",
                                "        [Link] private Irrigation Irrigation;",
                                "        [Link] private ISummary summary;",
                                "        // - Links to APSIM models",
                                "        //[Link] AgPasture.PastureSpecies Pasture;",
                                "",
                                "        List<AgPasture.PastureSpecies> Pasture = new List<AgPasture.PastureSpecies>();",
                                "",
                                "        //[Link(ByName = true)] Report HarvestReport;",
                                "",
                                "",
                                "        [Separator(\"NOTE WELL!! MUST start the sim the data after annual reporting and do a harvest on annual reporting day\")]",
                                "        [Description(\"Do reporting on each harvest?    :\")] public bool EnableOnHarvest { get; set; }",
                                "        [Description(\"Name of the component for harvest-based reporting    :\")] public string ReportNameHarvest { get; set; }",
                                "",
                                "        [Description(\"Do reporting at the end of each production year?    :\")] public bool EnableOnAnnual { get; set; }",
                                "        [Description(\"Name of the component for annual reporting    :\")] public string ReportNameAnnual { get; set; }",
                                "        [Description(\"Date for annual reporting - NOTE - must coincide with the end of one of the seasons below (dd-mmm)    :\")] public string ReportDateAnnual { get; set; }",
                                "",
                                "        [Description(\"Do the seasonal reporting)?    :\")] public bool EnableOnSeason { get; set; }",
                                "        [Description(\"Name of the component for seasonal reporting    :\")] public string ReportNameSeasonal { get; set; }",
                                "        [Description(\"Last day of summer for seasonal reporting (dd-mmm)\")] public string SummerEndDate { get; set; }",
                                "        [Description(\"Last day of autumn for seasonal reporting (dd-mmm)\")] public string AutumnEndDate { get; set; }",
                                "        [Description(\"Last day of winter for seasonal reporting (dd-mmm)\")] public string WinterEndDate { get; set; }",
                                "        [Description(\"Last day of spring for seasonal reporting (dd-mmm)\")] public string SpringEndDate { get; set; }",
                                "",
                                "        [Description(\"Do the summary reporting (at the end of the simulation)?    :\")] public bool EnableOnSummary { get; set; }",
                                "        [Description(\"Name of the component for summary (comparison to observed) reporting    :\")] public string ReportNameSummary { get; set; }",
                                "",
                                "",
                                "",
                                "        public double AnnualHarvestedWt { get; set; }",
                                "        public double AnnualIrrigated { get; set; }",
                                "        public double IntervalNHA { get; set; }",
                                "",
                                "        private bool doAnnualReport = false;",
                                "        private bool doAnnualReportCalculations = false;",
                                "        private bool doSeasonalReport = false;",
                                "        private bool doSummerReport = false;",
                                "        private bool doAutumnReport = false;",
                                "        private bool doWinterReport = false;",
                                "        private bool doSpringReport = false;",
                                "        private bool doSummerReportCalculations = false;",
                                "        private bool doAutumnReportCalculations = false;",
                                "        private bool doWinterReportCalculations = false;",
                                "        private bool doSpringReportCalculations = false;",
                                "",
                                "        [JsonIgnore][Units(\"kgDM/ha\")] public double AveAnnHarvested { get; set; }",
                                "        [JsonIgnore][Units(\"kgDM/ha\")] public double StdAnnHarvested { get; set; }",
                                "        [JsonIgnore][Units(\"kgDM/ha\")] public double RngAnnHarvested { get; set; }",
                                "",
                                "        [JsonIgnore][Units(\"kgDM/ha\")] public double AveSummerHarvested { get; set; }",
                                "        [JsonIgnore][Units(\"kgDM/ha\")] public double StdSummerHarvested { get; set; }",
                                "        [JsonIgnore][Units(\"kgDM/ha\")] public double RngSummerHarvested { get; set; }",
                                "        [JsonIgnore][Units(\"kgDM/ha\")] public double AveAutumnHarvested { get; set; }",
                                "        [JsonIgnore][Units(\"kgDM/ha\")] public double StdAutumnHarvested { get; set; }",
                                "        [JsonIgnore][Units(\"kgDM/ha\")] public double RngAutumnHarvested { get; set; }",
                                "        [JsonIgnore][Units(\"kgDM/ha\")] public double AveWinterHarvested { get; set; }",
                                "        [JsonIgnore][Units(\"kgDM/ha\")] public double StdWinterHarvested { get; set; }",
                                "        [JsonIgnore][Units(\"kgDM/ha\")] public double RngWinterHarvested { get; set; }",
                                "        [JsonIgnore][Units(\"kgDM/ha\")] public double AveSpringHarvested { get; set; }",
                                "        [JsonIgnore][Units(\"kgDM/ha\")] public double StdSpringHarvested { get; set; }",
                                "        [JsonIgnore][Units(\"kgDM/ha\")] public double RngSpringHarvested { get; set; }",
                                "",
                                "        [JsonIgnore][Units(\"kgDM/ha\")] public double[] AveSeasonalHarvested { get; set; }",
                                "        [JsonIgnore][Units(\"kgDM/ha\")] public double[] StdSeasonalHarvested { get; set; }",
                                "        [JsonIgnore][Units(\"kgDM/ha\")] public double[] RngSeasonalHarvested { get; set; }",
                                "",
                                "        [JsonIgnore][Units(\"-\")] public string Season { get; set; }",
                                "        [JsonIgnore][Units(\"-\")] public double SeasonNHA  { get; set; }",
                                "        [JsonIgnore][Units(\"-\")] public double SummerNHA  { get; set; }",
                                "        [JsonIgnore][Units(\"-\")] public double AutumnNHA  { get; set; }",
                                "        [JsonIgnore][Units(\"-\")] public double WinterNHA  { get; set; }",
                                "        [JsonIgnore][Units(\"-\")] public double SpringNHA  { get; set; }",
                                "",
                                "        [JsonIgnore][Units(\"kgDM/ha\")] public List<double> AnnHarvested = new List<double>();",
                                "        [JsonIgnore][Units(\"kgDM/ha\")] public List<double> SummerHarvested = new List<double>();",
                                "        [JsonIgnore][Units(\"kgDM/ha\")] public List<double> AutumnHarvested = new List<double>();",
                                "        [JsonIgnore][Units(\"kgDM/ha\")] public List<double> WinterHarvested = new List<double>();",
                                "        [JsonIgnore][Units(\"kgDM/ha\")] public List<double> SpringHarvested = new List<double>();",
                                "        //List<double> harvestedWtSums = new List<double>();",
                                "        private int CountYears = 0;",
                                "        private bool GrazedToday;",
                                "",
                                "        [EventSubscribe(\"StartOfSimulation\")]",
                                "        private void OnStartOfSimulation(object sender, EventArgs e)",
                                "        {",
                                "            foreach (PastureSpecies species in zone.FindAllChildren<PastureSpecies>().OfType<IModel>().ToList())",
                                "                Pasture.Add(species);",
                                "",
                                "            CountYears = 0;",
                                "",
                                "            Season = \"Unknown\";",
                                "            SeasonNHA = 0.0;",
                                "            SummerNHA = 0.0;",
                                "            AutumnNHA = 0.0;",
                                "            WinterNHA = 0.0;",
                                "            SpringNHA = 0.0;",
                                "        }",
                                "        ",
                                "        [EventSubscribe(\"StartOfYear\")]",
                                "        private void OnStartOfYear(object sender, EventArgs e)",
                                "        {",
                                "        }",
                                "",
                                "        [EventSubscribe(\"DoManagement\")]",
                                "        private void OnDoManagement(object sender, EventArgs e)",
                                "        {",
                                "            GrazedToday = false;",
                                "",
                                "            // Is this the day for annual reporting?",
                                "            doAnnualReportCalculations = false;  // this is to capture annual harvests etc for the final Summary report",
                                "            if (DateUtilities.DatesEqual(ReportDateAnnual, Clock.Today))",
                                "                doAnnualReportCalculations = true;",
                                "",
                                "            doAnnualReport = false;",
                                "            if (DateUtilities.DatesEqual(ReportDateAnnual, Clock.Today) && (EnableOnAnnual))",
                                "                doAnnualReport = true;",
                                "            else if (DateUtilities.DatesEqual(ReportDateAnnual, Clock.Today.AddDays(-1)))",
                                "            {",
                                "                AnnualHarvestedWt = 0.0;",
                                "                AnnualIrrigated = 0.0;            ",
                                "            }",
                                "",
                                "            doSummerReport = false;",
                                "            doAutumnReport = false;",
                                "            doWinterReport = false;",
                                "            doSpringReport = false;",
                                "            doSummerReportCalculations = false;",
                                "            doAutumnReportCalculations = false;",
                                "            doWinterReportCalculations = false;",
                                "            doSpringReportCalculations = false;",
                                "            if (DateUtilities.DatesEqual(SummerEndDate, Clock.Today))",
                                "            {",
                                "                Season = \"Summer\";",
                                "                doSummerReport = true;",
                                "                doSummerReportCalculations = true;",
                                "            }",
                                "            else if (DateUtilities.DatesEqual(SummerEndDate, Clock.Today.AddDays(-1)))",
                                "                SeasonNHA = 0.0;  // could move this zeroing",
                                "            else if (DateUtilities.DatesEqual(AutumnEndDate, Clock.Today))",
                                "            {",
                                "                Season = \"Autumn\";",
                                "                doAutumnReport = true;",
                                "                doAutumnReportCalculations = true;",
                                "            }",
                                "            else if (DateUtilities.DatesEqual(AutumnEndDate, Clock.Today.AddDays(-1)))",
                                "                SeasonNHA = 0.0;",
                                "            else if (DateUtilities.DatesEqual(WinterEndDate, Clock.Today))",
                                "            {",
                                "                Season = \"Winter\";",
                                "                doWinterReport = true;",
                                "                doWinterReportCalculations = true;",
                                "            }",
                                "            else if (DateUtilities.DatesEqual(WinterEndDate, Clock.Today.AddDays(-1)))",
                                "                SeasonNHA = 0.0;",
                                "            else if (DateUtilities.DatesEqual(SpringEndDate, Clock.Today))",
                                "            {",
                                "                Season = \"Spring\";",
                                "                doSpringReport = true;",
                                "                doSpringReportCalculations = true;",
                                "            }",
                                "            else if (DateUtilities.DatesEqual(SpringEndDate, Clock.Today.AddDays(-1)))",
                                "                SeasonNHA = 0.0;",
                                "        }",
                                "",
                                "        [EventSubscribe(\"Grazed\")]",
                                "        private void OnGrazed(object sender, EventArgs e)",
                                "        {",
                                "            // Grazing happened today.",
                                "            GrazedToday = true;",
                                "        }",
                                "",
                                "        [EventSubscribe(\"DoManagementCalculations\")]",
                                "        private void OnDoManagementCalculations(object sender, EventArgs e)",
                                "        {",
                                "            foreach (PastureSpecies species in Pasture)",
                                "            {",
                                "                AnnualHarvestedWt += species.NetGrowthWt;",
                                "                IntervalNHA += species.NetGrowthWt;",
                                "                SeasonNHA += species.NetGrowthWt;",
                                "            }",
                                "",
                                "            AnnualIrrigated += Irrigation.IrrigationApplied;",
                                "",
                                "            if ((GrazedToday) && (EnableOnHarvest))",
                                "            {",
                                "                Models.Report harvestReport = this.FindInScope(ReportNameHarvest) as Models.Report;",
                                "                if (harvestReport == null)",
                                "                    throw new Exception(string.Format(\"Unable to locate report {0}.\", ReportNameHarvest));",
                                "                harvestReport.DoOutput();",
                                "                IntervalNHA = 0.0;",
                                "            }",
                                "",
                                "            if (EnableOnSeason && (doSummerReport || doAutumnReport || doWinterReport || doSpringReport))",
                                "            {",
                                "                Models.Report seasonalReport = this.FindInScope(ReportNameSeasonal) as Models.Report;",
                                "                if (seasonalReport == null)",
                                "                    throw new Exception(string.Format(\"Unable to locate report {0}.\", ReportNameSeasonal));",
                                "                seasonalReport.DoOutput();",
                                "            }",
                                "",
                                "            if (doAnnualReportCalculations)",
                                "                AnnHarvested.Add(AnnualHarvestedWt);",
                                "            if (doSummerReportCalculations)",
                                "                SummerHarvested.Add(SeasonNHA);",
                                "            if (doAutumnReportCalculations)",
                                "                AutumnHarvested.Add(SeasonNHA);",
                                "            if (doWinterReportCalculations)",
                                "                WinterHarvested.Add(SeasonNHA);",
                                "            if (doSpringReportCalculations)",
                                "                SpringHarvested.Add(SeasonNHA);",
                                "",
                                "            if (doAnnualReport)",
                                "            {",
                                "                Models.Report annualReport = this.FindInScope(ReportNameAnnual) as Models.Report;",
                                "                if (annualReport == null)",
                                "                    throw new Exception(string.Format(\"Unable to locate annual report {0}.\", ReportNameAnnual));",
                                "                annualReport.DoOutput();",
                                "            }",
                                "",
                                "        }",
                                "",
                                "        [EventSubscribe(\"EndOfSimulation\")]",
                                "        private void OnEndOfSimulation(object sender, EventArgs e)",
                                "        {",
                                "            if (EnableOnSummary)",
                                "            {",
                                "",
                                "                AveAnnHarvested = MathUtilities.Average(AnnHarvested);",
                                "                StdAnnHarvested = MathUtilities.SampleStandardDeviation(AnnHarvested);",
                                "                RngAnnHarvested = MathUtilities.Max(AnnHarvested) - MathUtilities.Min(AnnHarvested);",
                                "",
                                "                AveSummerHarvested = MathUtilities.Average(SummerHarvested);",
                                "                StdSummerHarvested = MathUtilities.SampleStandardDeviation(SummerHarvested);",
                                "                RngSummerHarvested = MathUtilities.Max(SummerHarvested) - MathUtilities.Min(SummerHarvested);",
                                "",
                                "                AveAutumnHarvested = MathUtilities.Average(AutumnHarvested);",
                                "                StdAutumnHarvested = MathUtilities.SampleStandardDeviation(AutumnHarvested);",
                                "                RngAutumnHarvested = MathUtilities.Max(AutumnHarvested) - MathUtilities.Min(AutumnHarvested);",
                                "",
                                "                AveWinterHarvested = MathUtilities.Average(WinterHarvested);",
                                "                StdWinterHarvested = MathUtilities.SampleStandardDeviation(WinterHarvested);",
                                "                RngWinterHarvested = MathUtilities.Max(WinterHarvested) - MathUtilities.Min(WinterHarvested);",
                                "",
                                "                AveSpringHarvested = MathUtilities.Average(SpringHarvested);",
                                "                StdSpringHarvested = MathUtilities.SampleStandardDeviation(SpringHarvested);",
                                "                RngSpringHarvested = MathUtilities.Max(SpringHarvested) - MathUtilities.Min(SpringHarvested);",
                                "",
                                "",
                                "",
                                "                Models.Report summaryReport = this.FindInScope(ReportNameSummary) as Models.Report;",
                                "                if (summaryReport == null)",
                                "                    throw new Exception(string.Format(\"Unable to locate annual report {0}.\", ReportNameSummary));",
                                "                summaryReport.DoOutput();",
                                "            }",
                                "        }",
                                "",
                                "",
                                "    }",
                                "}"
                              ],
                              "Parameters": [
                                {
                                  "Key": "EnableOnHarvest",
                                  "Value": "False"
                                },
                                {
                                  "Key": "ReportNameHarvest",
                                  "Value": "HarvestReport"
                                },
                                {
                                  "Key": "EnableOnAnnual",
                                  "Value": "False"
                                },
                                {
                                  "Key": "ReportNameAnnual",
                                  "Value": "AnnualReport"
                                },
                                {
                                  "Key": "ReportDateAnnual",
                                  "Value": "31-may"
                                },
                                {
                                  "Key": "EnableOnSeason",
                                  "Value": "False"
                                },
                                {
                                  "Key": "ReportNameSeasonal",
                                  "Value": ""
                                },
                                {
                                  "Key": "SummerEndDate",
                                  "Value": "28-feb"
                                },
                                {
                                  "Key": "AutumnEndDate",
                                  "Value": "31-may"
                                },
                                {
                                  "Key": "WinterEndDate",
                                  "Value": "31-aug"
                                },
                                {
                                  "Key": "SpringEndDate",
                                  "Value": "30-nov"
                                },
                                {
                                  "Key": "EnableOnSummary",
                                  "Value": "True"
                                },
                                {
                                  "Key": "ReportNameSummary",
                                  "Value": "SummaryReport"
                                }
                              ],
                              "Name": "DoReporting",
                              "ResourceName": null,
                              "Children": [],
                              "Enabled": true,
                              "ReadOnly": false
                            }
                          ],
                          "Enabled": true,
                          "ReadOnly": false
                        },
                        {
                          "$type": "Models.AgPasture.SimpleGrazing, Models",
                          "GrazingRotationType": 2,
                          "SimpleGrazingFrequencyString": null,
                          "SimpleMinGrazable": 3500.0,
                          "SimpleGrazingResidual": 2000.0,
                          "PreGrazeDMArray": [
                            1000.0,
                            1000.0,
                            1000.0,
                            1000.0,
