                        {
                          "$type": "Models.Report, Models",
                          "VariableNames": [
                            "[Clock].Today as Date",
                            "",
                            "([AgPRyegrass].AboveGround.Wt + [AgPWhiteClover].AboveGround.Wt) as AbovegroundWt",
                            "([AgPRyegrass].AboveGround.N + [AgPWhiteClover].AboveGround.N)/([AgPRyegrass].AboveGround.Wt + [AgPWhiteClover].AboveGround.Wt + 0.000000001) as HerbageNConc",
                            "[AgPWhiteClover].AboveGroundWt/([AgPRyegrass].AboveGroundWt + [AgPWhiteClover].AboveGroundWt + 0.000000001) as CloverContent"
                          ],
                          "EventNames": [
