                        {
                          "$type": "Models.Manager, Models",
                          "CodeArray": [
                            "// This script will trigger a report on given dates as set up in the UI.",
                            "// It is aimed at gathering annual and seasonal summaries (actual sums are done elsewhere).",
                            "// Developed by RCichota, last updated in 13/Mar/20",
                            "",
                            "using System;",
                            "using System.Linq;",
                            "using System.Xml.Serialization;",
                            "using System.Collections.Generic;",
                            "using APSIM.Shared.Utilities;",
                            "using Models.Core;",
                            "using Models.PMF;",
                            "using Models.Soils;",
                            "using Models.Soils.Nutrients;",
                            "using Models.PMF.Interfaces;",
                            "using Models.Interfaces;",
                            "using Newtonsoft.Json;",
                            "",
                            "namespace Models",
                            "{",
                            "    [Serializable]",
                            "    public class Script : Model",
                            "    {",
                            "        //> Links to other Apsim models",
                            "        [Link] private Clock clock;",
                            "        [Link] private Zone myZone;",
                            "        [Link] private ISummary summary;",
                            "",
                            "        //> User inputs from properties tab",
                            "        [Separator(\"Manager to trigger reporting at given dates\")]",
                            "        [Separator(\" Annual reporting\")]",
                            "        [Description(\"  Trigger reporting at the end of each production year?\")]",
                            "        public bool AnnualReportEnabled { get; set; }",
                            "        [Description(\"  Name of the component for annual reporting:\")]",
                            "        public string AnnualReportName { get; set; }",
                            "        [Description(\"  Date for annual reporting (dd-mmm):\")]",
                            "        public string AnnualReportDate { get; set; }",
                            "",
                            "        [Separator(\" Seasonal reporting\")]",
                            "        [Description(\"  Trigger reporting at the end of each season?\")]",
                            "        public bool SeasonalReportEnabled { get; set; }",
                            "        [Description(\"  Name of the component for seasonal reporting:\")]",
                            "        public string SeasonalReportName { get; set; }",
                            "        [Description(\"  Date for spring season's reporting (dd-mmm)\")]",
                            "        public string SpringReportDate { get; set; }",
                            "        [Description(\"  Date for summer season's reporting (dd-mmm)\")]",
                            "        public string SummerReportDate { get; set; }",
                            "        [Description(\"  Date for autumn season's reporting (dd-mmm)\")]",
                            "        public string AutumnReportDate { get; set; }",
                            "        [Description(\"  Date for winter season's reporting (dd-mmm)\")]",
                            "        public string WinterReportDate { get; set; }",
                            "",
                            "        //> Internal variables",
                            "        private Models.Report annualReport;",
                            "        private Models.Report seasonalReport;",
                            "",
                            "",
                            "        [EventSubscribe(\"StartOfSimulation\")]",
                            "        private void OnStartOfSimulation(object sender, EventArgs e)",
                            "        {",
                            "            // get the links to the reporting components",
                            "            if (AnnualReportEnabled)",
                            "            {",
                            "                annualReport = this.FindInScope(AnnualReportName) as Models.Report;",
                            "                if (annualReport == null)",
                            "                {",
                            "                         throw new Exception(string.Format(\"Unable to locate report {0}. Check component name.\", AnnualReportName));",
                            "                }",
                            "            }",
                            "",
                            "            if (SeasonalReportEnabled)",
                            "            {",
                            "                seasonalReport = this.FindInScope(SeasonalReportName) as Models.Report;",
                            "                if (seasonalReport == null)",
                            "                {",
                            "                     throw new Exception(string.Format(\"Unable to locate report {0}. Check component name.\", SeasonalReportName));",
                            "                }",
                            "            }",
                            "            ",
                            "            // write initialisation message",
                            "            summary.WriteMessage(this, \" ReportingManager initialised\", MessageType.Diagnostic);",
                            "            if (AnnualReportEnabled)",
                            "            {",
                            "                summary.WriteMessage(this, \"   Annual report will be trigger on \" + AnnualReportDate + \", using the component \" + AnnualReportName, MessageType.Diagnostic);",
                            "            }",
                            "",
                            "            if (SeasonalReportEnabled)",
                            "            {",
                            "                summary.WriteMessage(this, \"   Annual report will be trigger on \" + SpringReportDate + \", \" + SummerReportDate + \", \" + AutumnReportDate ",
                            "                                       + \", and \" + WinterReportDate + \", using the component \" + SeasonalReportName, MessageType.Diagnostic);",
                            "            }",
                            "        }",
                            "",
                            "        [EventSubscribe(\"DoManagementCalculations\")]",
                            "        private void OnDoManagementCalculations(object sender, EventArgs e)",
                            "        {",
                            "            if (AnnualReportEnabled)",
                            "            {",
                            "                if (DateUtilities.DatesAreEqual(AnnualReportDate, clock.Today))",
                            "                {",
                            "                    annualReport.DoOutput();",
                            "                }",
                            "            }",
                            "",
                            "            if (SeasonalReportEnabled)",
                            "            {",
                            "                if ((DateUtilities.DatesAreEqual(SpringReportDate, clock.Today)) ||",
                            "                    (DateUtilities.DatesAreEqual(SummerReportDate, clock.Today)) ||",
                            "                    (DateUtilities.DatesAreEqual(AutumnReportDate, clock.Today)) ||",
                            "                    (DateUtilities.DatesAreEqual(WinterReportDate, clock.Today)))",
                            "                {",
                            "                    seasonalReport.DoOutput();",
                            "                }",
                            "            }",
                            "        }",
                            "    }",
                            "}"
                          ],
                          "Parameters": [
                            {
                              "Key": "AnnualReportEnabled",
                              "Value": "False"
                            },
                            {
                              "Key": "AnnualReportName",
                              "Value": "AnnualReport"
                            },
                            {
                              "Key": "AnnualReportDate",
                              "Value": "30-Jun"
                            },
                            {
                              "Key": "SeasonalReportEnabled",
                              "Value": "False"
                            },
                            {
                              "Key": "SeasonalReportName",
                              "Value": ""
                            },
                            {
                              "Key": "SpringReportDate",
                              "Value": ""
                            },
                            {
                              "Key": "SummerReportDate",
                              "Value": ""
                            },
                            {
                              "Key": "AutumnReportDate",
                              "Value": ""
                            },
                            {
                              "Key": "WinterReportDate",
                              "Value": ""
                            }
                          ],
                          "Name": "ReportingManager",
                          "ResourceName": null,
                          "Children": [],
                          "Enabled": true,
                          "ReadOnly": false
                        },
